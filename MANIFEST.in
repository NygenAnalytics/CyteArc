recursive-exclude * __pycache__
recursive-exclude * *.pyc
recursive-exclude * *.pyo
exclude .gitignore
exclude .gitattributes
exclude .python-version
exclude .readthedocs.yml
exclude codecov.yml
exclude Dockerfile
prune docs
prune tests
prune profiling
prune scripts
prune .circleci
prune .github
include README.md
